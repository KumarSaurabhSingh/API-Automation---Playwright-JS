# Copy this file to .env and adjust the values for your environment.

TEST_ENV=qa
BASE_URL=https://dummyjson.com

# HTTP client behaviour
API_TIMEOUT_MS=30000
API_RETRIES=1
API_RETRY_DELAY_MS=750
API_MAX_REDIRECTS=5

# Observability: error | warn | info | debug
LOG_LEVEL=info
LOG_TO_FILE=true

# Demo account for https://dummyjson.com/auth/login
AUTH_USERNAME=emilys
AUTH_PASSWORD=emilyspass

# When true, global setup fails fast if the API is unreachable
HEALTH_CHECK_STRICT=true

# Number of Playwright workers
WORKERS=2
