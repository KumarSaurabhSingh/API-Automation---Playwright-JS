{
  "compilerOptions": {
    "checkJs": false,
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": ["src/**/*.js", "tests/**/*.js", "playwright.config.js"],
  "exclude": ["node_modules", "reports", "logs"]
}
