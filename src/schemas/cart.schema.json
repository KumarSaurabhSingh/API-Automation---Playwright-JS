{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.playwright-api-automation.local/cart.schema.json",
  "title": "Cart",
  "type": "object",
  "required": [
    "id",
    "products",
    "total",
    "discountedTotal",
    "userId",
    "totalProducts",
    "totalQuantity"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "products": {
      "type": "array",
      "items": { "$ref": "https://schemas.playwright-api-automation.local/cart-product.schema.json" }
    },
    "total": { "type": "number", "minimum": 0 },
    "discountedTotal": { "type": "number", "minimum": 0 },
    "userId": { "type": "integer", "minimum": 1 },
    "totalProducts": { "type": "integer", "minimum": 0 },
    "totalQuantity": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
